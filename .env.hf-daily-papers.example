# Copy this file to .env.hf-daily-papers.local and fill in local values as needed.

HF_DAILY_PAPERS_API_BASE=https://huggingface.co/api
HF_DAILY_PAPERS_DAYS=3
HF_DAILY_PAPERS_LIMIT=25
HF_DAILY_PAPERS_REPORT=sources/library/hf-daily-papers/hf-daily-papers-latest.md
HF_DAILY_PAPERS_INBOX_DIR=sources/inbox/hf-daily-papers
HF_DAILY_PAPERS_STATE=sources/library/hf-daily-papers/hf-daily-papers-state.json
HF_DAILY_PAPERS_MODEL=gpt-5.4-mini
HF_DAILY_PAPERS_REASONING_EFFORT=low
HF_DAILY_PAPERS_CODEX_BIN=codex
HF_DAILY_PAPERS_FORCE_IPV4=1
# HF_DAILY_PAPERS_TIMEOUT=30
# HF_DAILY_PAPERS_VERIFY_TLS=1
# HF_DAILY_PAPERS_SOURCE_TIMEOUT=30
# HF_DAILY_PAPERS_SOURCE_VERIFY_TLS=1
# HF_DAILY_PAPERS_SOURCE_FORCE_IPV4=1
# HF_DAILY_PAPERS_CODEX_TIMEOUT=240
# HF_DAILY_PAPERS_INCLUDE_MAYBE=1
# HF_DAILY_PAPERS_FILTER_PROMPT=system/templates/hf-paper-filter-prompt.md
# HF_DAILY_PAPERS_EXTRACTION_PROMPT=system/templates/hf-paper-knowledge-prompt.md
