# Copy this file to .env.daily-digest.local and fill in local values as needed.

DAILY_DIGEST_TO=your-email@example.com
DAILY_DIGEST_SUBJECT_PREFIX=[wiki]
# Gmail SMTP with OAuth2 example:
# DAILY_DIGEST_SMTP_HOST=smtp.gmail.com
# DAILY_DIGEST_SMTP_PORT=465
# DAILY_DIGEST_SMTP_SECURITY=ssl
# DAILY_DIGEST_SMTP_AUTH_METHOD=gmail-oauth2
# DAILY_DIGEST_SMTP_USERNAME=your-account@gmail.com
# DAILY_DIGEST_FROM=your-account@gmail.com
# DAILY_DIGEST_GMAIL_OAUTH_CLIENT_ID=your-google-oauth-client-id
# DAILY_DIGEST_GMAIL_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
# DAILY_DIGEST_GMAIL_OAUTH_REFRESH_TOKEN=your-google-oauth-refresh-token
#
# Gmail SMTP with app password example:
# DAILY_DIGEST_SMTP_HOST=smtp.gmail.com
# DAILY_DIGEST_SMTP_PORT=465
# DAILY_DIGEST_SMTP_SECURITY=ssl
# DAILY_DIGEST_SMTP_AUTH_METHOD=password
# DAILY_DIGEST_SMTP_USERNAME=your-account@gmail.com
# DAILY_DIGEST_SMTP_PASSWORD=your-16-char-app-password
# DAILY_DIGEST_FROM=your-account@gmail.com
#
# Fallback: local sendmail / Postfix
# DAILY_DIGEST_SENDMAIL_BIN=/usr/sbin/sendmail

# DAILY_DIGEST_STEP_TIMEOUT=1800
# DAILY_DIGEST_STEP_RETRIES=1
# DAILY_DIGEST_SEND_TIMEOUT=120
# DAILY_DIGEST_REPLY_TO=
