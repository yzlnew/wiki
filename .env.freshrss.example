# Copy this file to .env.freshrss.local and fill in your local values.

FRESHRSS_BASE_URL=http://example.com:6789
FRESHRSS_USERNAME=replace-me
FRESHRSS_API_PASSWORD=replace-me
FRESHRSS_LIMIT=50
FRESHRSS_REPORT=sources/library/freshrss/freshrss-latest.md
FRESHRSS_INBOX_DIR=sources/inbox/freshrss
FRESHRSS_FORCE_IPV4=1
# FRESHRSS_API_BASE=http://example.com:6789/api/greader.php
# FRESHRSS_VERIFY_TLS=0
# ARTICLE_FORCE_IPV4=1
# ARTICLE_VERIFY_TLS=1
# ARTICLE_TIMEOUT=30
# FRESHRSS_INCLUDE_MAYBE=1
